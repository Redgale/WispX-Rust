{
	"name": "wispx-epoxy-tls",
	"version": "1.0.0",
	"description": "epoxy-tls with WispX: a wasm library for encrypted TLS/TCP/UDP/HTTPS/WebSocket streams in the browser over Wisp, speaking WispX (and Wisp V2/V1)",
	"scripts": {
		"build": "bash build.sh",
		"prepack": "npm run build && bash publish.sh"
	},
	"keywords": [
		"wispx",
		"wisp",
		"wasm",
		"ssl",
		"tls",
		"rust",
		"proxy",
		"http"
	],
	"author": "MercuryWorkshop, WispX contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Redgale/WispX-Rust.git",
		"directory": "client"
	},
	"license": "AGPL-3.0-only",
	"files": [
		"full",
		"minimal",
		"README.md",
		"LICENSE"
	],
	"packageManager": "pnpm@10.27.0",
	"exports": {
		".": {
			"import": "./full/epoxy-bundled.js",
			"types": "./full/epoxy-bundled.d.ts"
		},
		"./epoxy": {
			"import": "./full/epoxy.js",
			"types": "./full/epoxy.d.ts"
		},
		"./epoxy-bundled": {
			"import": "./full/epoxy-bundled.js",
			"types": "./full/epoxy-bundled.d.ts"
		},
		"./minimal-epoxy": {
			"import": "./minimal/epoxy.js",
			"types": "./minimal/epoxy.d.ts"
		},
		"./minimal-epoxy-bundled": {
			"import": "./minimal/epoxy-bundled.js",
			"types": "./minimal/epoxy-bundled.d.ts"
		}
	},
	"browser": "./full/epoxy-bundled.js",
	"module": "./full/epoxy-bundled.js",
	"main": "./full/epoxy-bundled.js",
	"types": "./full/epoxy-bundled.d.ts"
}
